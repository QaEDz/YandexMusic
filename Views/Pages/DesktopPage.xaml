<Page x:Class="MuSync.DesktopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <StackPanel MaxWidth="760" Margin="12,8,12,20">

        <TextBlock Text="Рабочий стол" Style="{StaticResource SettingsSectionHeader}" Margin="0,8,0,0" />

        <!-- ============ Скрытие значков двойным кликом ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Скрывать значки двойным кликом" Style="{StaticResource SettingsCardTitle}" />
                    <TextBlock Text="Двойной клик по пустому месту рабочего стола плавно скрывает все ярлыки, повторный — возвращает обратно. Открытию программ по ярлыкам не мешает."
                               Style="{StaticResource SettingsCardDescription}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="DoubleClickHideToggle" Grid.Column="2" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============ Прозрачность значков ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ColorBackground24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" Text="Прозрачность значков рабочего стола" Style="{StaticResource SettingsCardTitle}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="2" Text="100%" MinWidth="48"
                               TextAlignment="Right" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Slider x:Name="IconOpacitySlider" Margin="0,14,0,0"
                        Minimum="20" Maximum="100" Value="100"
                        SmallChange="1" LargeChange="5"
                        ValueChanged="IconOpacitySlider_ValueChanged" />
                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Эффект применяется сразу при перетаскивании ползунка (100% — стандартная непрозрачность). После выхода из MuSync значение сбрасывается." />
            </StackPanel>
        </Border>

    </StackPanel>
</Page>