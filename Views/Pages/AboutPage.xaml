<Page x:Class="MuSync.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <StackPanel MaxWidth="760" Margin="12,8,12,20">

        <TextBlock Text="О программе" Style="{StaticResource SettingsSectionHeader}" Margin="0,8,0,0" />

        <!-- ============ О приложении ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="AppIcon" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MuSync" FontSize="24" FontWeight="Bold" />
                        <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Версия --" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Показывает текущий трек из Яндекс Музыки, NetEase Music, QQ Music и Soda Music в вашем статусе Steam. Также поддерживает пользовательскую подпись и фарм игровых часов." />
                <TextBlock x:Name="RuntimeText" Margin="0,10,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="" />
            </StackPanel>
        </Border>

        <!-- ============ Ссылки ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Ссылки проекта" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Margin="0,8,0,0" FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/kernel12345/musync"
                               RequestNavigate="Link_RequestNavigate">github.com/kernel12345/musync</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,6,0,0" FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/kernel12345/musync/releases"
                               RequestNavigate="Link_RequestNavigate">Скачать последнюю версию (Releases)</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============ Лицензия ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Авторские права и лицензия" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Copyright © 2026 MuSync contributors" />
                <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Приложение распространяется под открытой лицензией MIT: вы можете свободно использовать, копировать, изменять и распространять его без каких-либо гарантий. Полный текст лицензии — в файле LICENSE в корне репозитория." />
            </StackPanel>
        </Border>

        <!-- ============ Благодарности ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Открытые компоненты" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Style="{StaticResource SettingsCardDescription}" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="При создании MuSync использованы следующие проекты и библиотеки с открытым исходным кодом:" />

                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="wuyan1337/yySync (MIT)" />
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/wuyan1337/yySync"
                               RequestNavigate="Link_RequestNavigate">github.com/wuyan1337/yySync</Hyperlink>
                    <Run Text="  ·  Copyright (c) 2018 Kyle" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>

                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="SteamKit2 (LGPL-2.1)" />
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/SteamRE/SteamKit"
                               RequestNavigate="Link_RequestNavigate">github.com/SteamRE/SteamKit</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="WPF-UI (MIT)" />
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/lepoco/wpfui"
                               RequestNavigate="Link_RequestNavigate">github.com/lepoco/wpfui</Hyperlink>
                    <Run Text="  ·  Copyright (c) 2021-2024 Leszek Pomianowski and WPF UI Contributors"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>

                <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Также используются библиотеки .NET: Microsoft.Win32.Registry, System.Security.Cryptography.ProtectedData (MIT). Подробности — в файле THIRD-PARTY-NOTICES.md." />
            </StackPanel>
        </Border>

        <TextBlock Margin="4,2,4,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="MuSync — независимый проект с открытым исходным кодом, не связанный с Valve, Яндексом, NetEase, Tencent или ByteDance. Все товарные знаки принадлежат их владельцам." />

    </StackPanel>
</Page>