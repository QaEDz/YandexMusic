<Page x:Class="MuSync.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <StackPanel MaxWidth="760" Margin="12,8,12,20">

            <TextBlock Text="Музыкальные плееры" Style="{StaticResource SettingsSectionHeader}" />

            <!-- ============ Плеер 0: NetEase Cloud Music ============ -->
            <Border Style="{StaticResource PlayerCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CoverBorder0" Width="88" Height="88" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <ui:SymbolIcon x:Name="CoverPlaceholder0" Symbol="MusicNote124" FontSize="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlayerName0" Text="NetEase Music" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBlock x:Name="SongTitle0" Text="Ничего не играет" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Artist0" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Album0" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="165" VerticalAlignment="Center">
                        <TextBlock x:Name="Status0" Text="Не запущен" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="Progress0" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" />
                        <TextBlock x:Name="ProgressText0" Text="00:00 / 00:00" FontSize="11" Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Плеер 1: QQ Music ============ -->
            <Border Style="{StaticResource PlayerCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CoverBorder1" Width="88" Height="88" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <ui:SymbolIcon x:Name="CoverPlaceholder1" Symbol="MusicNote124" FontSize="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlayerName1" Text="QQ Music" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBlock x:Name="SongTitle1" Text="Ничего не играет" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Artist1" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Album1" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="165" VerticalAlignment="Center">
                        <TextBlock x:Name="Status1" Text="Не запущен" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="Progress1" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" />
                        <TextBlock x:Name="ProgressText1" Text="00:00 / 00:00" FontSize="11" Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Плеер 2: Soda Music ============ -->
            <Border Style="{StaticResource PlayerCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CoverBorder2" Width="88" Height="88" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <ui:SymbolIcon x:Name="CoverPlaceholder2" Symbol="MusicNote124" FontSize="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlayerName2" Text="Soda Music" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBlock x:Name="SongTitle2" Text="Ничего не играет" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Artist2" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Album2" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="165" VerticalAlignment="Center">
                        <TextBlock x:Name="Status2" Text="Не запущен" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="Progress2" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" />
                        <TextBlock x:Name="ProgressText2" Text="00:00 / 00:00" FontSize="11" Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Плеер 3: Яндекс Музыка ============ -->
            <Border Style="{StaticResource PlayerCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CoverBorder3" Width="88" Height="88" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <ui:SymbolIcon x:Name="CoverPlaceholder3" Symbol="MusicNote124" FontSize="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlayerName3" Text="Яндекс Музыка" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBlock x:Name="SongTitle3" Text="Ничего не играет" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Artist3" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Album3" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="165" VerticalAlignment="Center">
                        <TextBlock x:Name="Status3" Text="Не запущен" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="Progress3" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" />
                        <TextBlock x:Name="ProgressText3" Text="00:00 / 00:00" FontSize="11" Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Нижняя строка статуса ============ -->
            <Grid Margin="4,6,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LastUpdateLabel" Text="Обновлено: --:--:--" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="SteamStateLabel" Grid.Column="2" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>

            <!-- ============ Статус Steam ============ -->
            <TextBlock Text="Статус Steam" Style="{StaticResource SettingsSectionHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Person24" Style="{StaticResource SettingsCardIcon}"
                                   VerticalAlignment="Top" Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Сессия Steam" Style="{StaticResource SettingsCardTitle}" FontWeight="SemiBold" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Подключение" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SConn" Grid.Column="1" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                            <TextBlock Text="Аккаунт" Grid.Row="1" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SLogon" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="8,4,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                            <TextBlock Text="Игра в Steam" Grid.Row="2" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SRealGame" Grid.Row="2" Grid.Column="1" FontSize="12" Margin="8,4,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                            <TextBlock Text="Пауза вручную" Grid.Row="3" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SManualPause" Grid.Row="3" Grid.Column="1" FontSize="12" Margin="8,4,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Предпросмотр статуса для друзей -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Что видят друзья в Steam" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock x:Name="PreviewText" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="--" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Мониторинг производительности ============ -->
            <TextBlock Text="Производительность" Style="{StaticResource SettingsSectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                    <TextBlock x:Name="MemoryInfoText" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Автообновление каждые 2 сек." VerticalAlignment="Center" />
                    <ui:Button x:Name="RefreshMemoryButton" Grid.Column="2" Content="Обновить" VerticalAlignment="Center"
                               Click="RefreshMemoryButton_Click" />
                </Grid>
            </Border>

        </StackPanel>
</Page>