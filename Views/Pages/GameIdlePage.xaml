<Page x:Class="MuSync.GameIdlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <StackPanel MaxWidth="760" Margin="12,8,12,20">

        <TextBlock Text="Фарм часов в играх" Style="{StaticResource SettingsSectionHeader}" />

        <!-- ============ Описание ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Games24" Style="{StaticResource SettingsCardIcon}"
                               VerticalAlignment="Top" Margin="0,2,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Набор часов и карточек Steam" Style="{StaticResource SettingsCardTitle}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SettingsCardDescription}" Margin="0,3,0,0"
                               TextWrapping="Wrap"
                               Text="Выберите игры из вашей библиотеки (до 30 одновременно): Steam будет засчитывать игровое время и выбивать коллекционные карточки. Синхронизация музыки при этом не прерывается — трек остаётся на первом месте в статусе." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Панель управления ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="IdleStateText" Style="{StaticResource SettingsCardTitle}" Text="Не запущено" />
                    <TextBlock x:Name="IdleElapsedText" HorizontalAlignment="Right" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="Поиск по названию или AppID…"
                                TextChanged="SearchBox_TextChanged" />
                    <ui:Button x:Name="RefreshButton" Grid.Column="1" Content="Обновить библиотеку" Margin="10,0,0,0"
                               VerticalAlignment="Center" Click="RefreshButton_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button x:Name="StartButton" Content="Запустить фарм" Appearance="Primary"
                               Click="StartButton_Click" />
                    <ui:Button x:Name="StopButton" Content="Остановить" Margin="10,0,0,0"
                               Visibility="Collapsed" Click="StopButton_Click" />
                    <ui:ProgressRing x:Name="LoadingRing" Margin="12,0,0,0" Width="22" Height="22"
                                     IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Выбрано: 0/30" />
                    <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ Список игр ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <ListBox x:Name="GamesListBox" Height="440" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="2,1" />
                        <Setter Property="Padding" Value="6,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Checked="GameCheckBox_Changed" Unchecked="GameCheckBox_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AppIdText}" Margin="8,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Margin="4,2,4,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Список загружается из лицензий Steam и кэшируется локально. После покупки новых игр нажмите «Обновить библиотеку». Время засчитывается только для игр на аккаунте (бесплатные нужно сначала добавить в библиотеку)." />

    </StackPanel>
</Page>