<Page x:Class="MuSync.PlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <StackPanel MaxWidth="760" Margin="12,8,12,20">

            <TextBlock Text="Плееры" Style="{StaticResource SettingsSectionHeader}" />

            <!-- ============ Плеер 0: NetEase Music ============ -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="MusicNote124" Style="{StaticResource SettingsCardIcon}"
                                   VerticalAlignment="Top" Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <TextBlock Text="NetEase Music" Style="{StaticResource SettingsCardTitle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="P0Active" Text="Не запущен" HorizontalAlignment="Right" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="P0State" Style="{StaticResource SettingsCardDescription}" Margin="0,3,0,0" Text="Без ошибок" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Трек" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="P0Song" Grid.Column="1" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                            <TextBlock Text="Исполнитель" Grid.Row="1" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="P0Artist" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="8,4,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                            <TextBlock Text="Альбом" Grid.Row="2" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="P0Album" Grid.Row="2" Grid.Column="1" FontSize="12" Margin="8,4,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                            <TextBlock Text="Прогресс" Grid.Row="3" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="P0Progress" Grid.Row="3" Grid.Column="1" FontSize="12" Margin="8,4,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="--" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

