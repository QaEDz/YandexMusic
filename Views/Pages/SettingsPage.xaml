<Page x:Class="MuSync.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <DockPanel>

        <!-- ==================== Верхняя панель ==================== -->
        <Grid DockPanel.Dock="Top" Margin="12,14,12,8">
            <TextBlock Text="Настройки" Style="{StaticResource SettingsSectionHeader}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button x:Name="LogoutButton" Content="Выйти из аккаунта" Margin="0,0,10,0" Click="LogoutButton_Click" />
                <ui:Button x:Name="LoginButton" Content="Войти заново" Click="LoginButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel MaxWidth="760" Margin="12,0,12,20">

            <!-- ==================== Основные настройки ==================== -->
            <TextBlock Text="Основные" Style="{StaticResource SettingsSectionHeader}" />
            <StackPanel>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Power24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Автозапуск с Windows" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Запускать MuSync автоматически при входе в систему" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="AutoStartToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Сворачивать в трей при закрытии" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Крестик не закрывает программу, а прячет её в область уведомлений" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Запускать свёрнутым в трей" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="При старте не показывать главное окно, а сразу работать в фоне" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="StartInTrayToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== Отображение в Steam ==================== -->
            <TextBlock Text="Отображение в Steam" Style="{StaticResource SettingsSectionHeader}" />
            <StackPanel>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Chat24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Синхронизация со Steam" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Отправлять текущий трек в ваш игровой статус Steam" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="EnableSteamSyncToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="PaintBrush24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Свой префикс" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Добавлять произвольный текст перед названием трека" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBox x:Name="CustomPrefixTextBox" Width="180" Margin="0,0,12,0"
                                        PlaceholderText="Например: Слушаю: " IsEnabled="False"
                                        TextChanged="TextBox_Changed" />
                            <ui:ToggleSwitch x:Name="EnableCustomPrefixToggle" VerticalAlignment="Center"
                                             Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Chat24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Подпись в простое и на паузе" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Когда музыка не играет, показывать свой текст в статусе Steam" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBox x:Name="CustomSignatureTextBox" Width="180" Margin="0,0,12,0"
                                        PlaceholderText="Например: Отдыхаю" IsEnabled="False"
                                        TextChanged="TextBox_Changed" />
                            <ui:ToggleSwitch x:Name="EnableCustomSignatureToggle" VerticalAlignment="Center"
                                             Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Cursor24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Показывать активное приложение" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Пока музыка не играет, передавать в Steam название открытой программы" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PushRealtimeActivityToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Person24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Показывать исполнителя" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Добавлять имя артиста после названия трека" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowArtistNameToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Play24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Показывать полосу прогресса" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="▰▰▰▱▱▱ 2:30/4:15" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowProgressBarToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Info24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Приоритет при нехватке места" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Что оставить, если строка статуса превышает лимит Steam" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="PriorityArtistRadio" Content="Исполнитель" Margin="0,0,12,0" GroupName="StatusPriority"
                                         Checked="Setting_Changed" />
                            <RadioButton x:Name="PriorityProgressRadio" Content="Прогресс" GroupName="StatusPriority"
                                         Checked="Setting_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Pause24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Пауза синхронизации во время игры" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Автоматически скрывать статус музыки, когда запущена игра в Steam" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PauseWhenPlayingGameToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Page>